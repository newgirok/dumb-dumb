# API 서버가 접속할 DB. RLS가 적용되려면 테이블 소유자가 아닌 app_api 롤이어야 한다
DATABASE_URL=postgresql://app_api@localhost:5432/postgres
DB_POOL_MAX=10

# 액세스/리프레시 시크릿은 반드시 서로 다른 값으로
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
HASH_ROUNDS=10

PORT=9001
WEB_ORIGIN=http://localhost:3000

# PG 웹훅 서명 검증 키 (PG사 콘솔에서 발급)
PG_WEBHOOK_SECRET=change-me-webhook

# 아바타 발급 워커. off 로 두면 이 인스턴스는 발급을 처리하지 않는다
AVATAR_WORKER=on
AVATAR_WORKER_INTERVAL_MS=2000

# 소셜 로그인. 미설정이면 해당 공급자 버튼이 400을 돌려준다.
# 카카오는 client_secret 이 선택 사항이라 비워도 된다.
# 공급자 콘솔에 리다이렉트 URI 를 등록해야 한다 (등록값과 정확히 일치해야 함):
#   http://localhost:3000/api/auth/oauth/kakao/callback
#   http://localhost:3000/api/auth/oauth/google/callback
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
